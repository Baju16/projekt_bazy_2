<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Klienci</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <h1>Lista Klientów</h1>

    <% if (error) { %>
        <div class="error-message" style="color: red; font-weight: bold; margin-bottom: 20px;">
            <%= error %>
        </div>
    <% } %>

    <!-- Przycisk do powrotu na stronę główną -->
    <button onclick="window.location.href='/home'">Powrót na stronę główną</button>

    <!-- Formularz dodawania nowego klienta -->
    <h2>Dodaj nowego klienta</h2>
    <form action="/clients/add" method="POST">
        <label for="imie">Imię:</label>
        <input type="text" id="imie" name="imie" required><br>
        <label for="nazwisko">Nazwisko:</label>
        <input type="text" id="nazwisko" name="nazwisko" required><br>
        <label for="nr_prawa_jazdy">Nr prawa jazdy:</label>
        <input type="text" id="nr_prawa_jazdy" name="nr_prawa_jazdy" required><br>
        <label for="email">Email:</label>
        <input type="email" id="email" name="email"><br>
        <label for="telefon">Telefon:</label>
        <input type="text" id="telefon" name="telefon"><br>
        <button type="submit">Zapisz</button>
    </form>

    <!-- Formularz do sprawdzania liczby wypożyczeń dla klienta -->
    <h2>Sprawdź liczbę wypożyczeń dla klienta</h2>
    <form id="rentalCountForm">
        <label for="clientId">ID klienta:</label>
        <input type="number" id="clientId" name="clientId" required>
        <button type="button" onclick="getRentalCount()">Sprawdź</button>
    </form>

    <div id="rentalCountResult" style="margin-top: 20px; font-weight: bold;">
        <!-- Tutaj wyświetli się wynik liczby wypożyczeń -->
    </div>

    <!-- Formularz do sprawdzania średniego kosztu wynajmu dla klienta -->
    <h2>Sprawdź średni koszt wynajmu dla klienta</h2>
    <form id="averageRentalCostForm">
        <label for="averageClientId">ID klienta:</label>
        <input type="number" id="averageClientId" name="clientId" required>
        <button type="button" onclick="getAverageRentalCost()">Sprawdź</button>
    </form>

    <div id="averageRentalCostResult" style="margin-top: 20px; font-weight: bold;">
        <!-- Tutaj wyświetli się wynik średniego kosztu wynajmu -->
    </div>

    <!-- Formularz do sprawdzania średniej liczby dni wypożyczenia dla klienta -->
    <h2>Sprawdź średnią liczbę dni wypożyczenia dla klienta</h2>
    <form id="averageRentalDaysForm">
        <label for="averageDaysClientId">ID klienta:</label>
        <input type="number" id="averageDaysClientId" name="clientId" required>
        <button type="button" onclick="getAverageRentalDays()">Sprawdź</button>
    </form>

    <div id="averageRentalDaysResult" style="margin-top: 20px; font-weight: bold;">
        <!-- Tutaj wyświetli się wynik średniej liczby dni wypożyczenia -->
    </div>

    <!-- Sekcja z listą klientów -->
    <h2>Lista klientów</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Imię</th>
                <th>Nazwisko</th>
                <th>Nr prawa jazdy</th>
                <th>Email</th>
                <th>Telefon</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            <% clients.forEach(client => { %>
                <tr>
                    <td><%= client.id %></td>
                    <td><%= client.imie %></td>
                    <td><%= client.nazwisko %></td>
                    <td><%= client.nr_prawa_jazdy %></td>
                    <td><%= client.email %></td>
                    <td><%= client.telefon %></td>
                    <td>
                        <!-- Przycisk do edytowania klienta -->
                        <button onclick="editClient('<%= client.id %>', '<%= client.imie %>', '<%= client.nazwisko %>', '<%= client.nr_prawa_jazdy %>', '<%= client.email %>', '<%= client.telefon %>')">Edytuj</button>
                        <!-- Link do usuwania klienta -->
                        <a href="/clients/delete/<%= client.id %>">Usuń</a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <!-- Formularz edytowania klienta (po kliknięciu "Edytuj") -->
    <h2>Edytuj klienta</h2>
    <form id="editForm" action="" method="POST" style="display: none;">
        <input type="hidden" id="editId" name="id">
        <label for="editImie">Imię:</label>
        <input type="text" id="editImie" name="imie" required><br>
        <label for="editNazwisko">Nazwisko:</label>
        <input type="text" id="editNazwisko" name="nazwisko" required><br>
        <label for="editNr_prawa_jazdy">Nr prawa jazdy:</label>
        <input type="text" id="editNr_prawa_jazdy" name="nr_prawa_jazdy" required><br>
        <label for="editEmail">Email:</label>
        <input type="email" id="editEmail" name="email"><br>
        <label for="editTelefon">Telefon:</label>
        <input type="text" id="editTelefon" name="telefon"><br>
        <button type="submit">Zapisz zmiany</button>
    </form>

    <script>
        // Funkcja do załadowania formularza edytowania
        function editClient(id, imie, nazwisko, nr_prawa_jazdy, email, telefon) {
            document.getElementById("editForm").style.display = "block"; // Pokaż formularz edycji
            document.getElementById("editId").value = id;
            document.getElementById("editImie").value = imie;
            document.getElementById("editNazwisko").value = nazwisko;
            document.getElementById("editNr_prawa_jazdy").value = nr_prawa_jazdy;
            document.getElementById("editEmail").value = email;
            document.getElementById("editTelefon").value = telefon;

            // Zmieniamy akcję formularza na edytowanie
            document.getElementById("editForm").action = "/clients/edit/" + id;
        }
    </script>

    <script>
        async function getRentalCount() {
            const clientId = document.getElementById("clientId").value;

            if (!clientId) {
                alert("Proszę podać ID klienta!");
                return;
            }

            try {
                const response = await fetch(`/clients/rental-count/${clientId}`);
                const data = await response.json();

                if (data.error) {
                    document.getElementById("rentalCountResult").textContent = data.error;
                } else {
                    document.getElementById("rentalCountResult").textContent = 
                        `Liczba wypożyczeń dla klienta o ID ${clientId}: ${data.liczba_wypozyczen}`;
                }
            } catch (error) {
                console.error(error);
                document.getElementById("rentalCountResult").textContent = 
                    "Wystąpił błąd podczas próby pobrania danych.";
            }
        }
    </script>

    <script>
        async function getAverageRentalCost() {
            const clientId = document.getElementById("averageClientId").value;

            if (!clientId) {
                alert("Proszę podać ID klienta!");
                return;
            }

            try {
                const response = await fetch(`/clients/average-rental-cost/${clientId}`);
                const data = await response.json();

                if (data.error) {
                    document.getElementById("averageRentalCostResult").textContent = data.error;
                } else {
                    document.getElementById("averageRentalCostResult").textContent = 
                        `Średni koszt wynajmu dla klienta o ID ${clientId}: ${data.sredni_koszt}`;
                }
            } catch (error) {
                console.error(error);
                document.getElementById("averageRentalCostResult").textContent = 
                    "Wystąpił błąd podczas próby pobrania danych.";
            }
        }
    </script>

    <script>
        async function getAverageRentalDays() {
            const clientId = document.getElementById("averageDaysClientId").value;

            if (!clientId) {
                alert("Proszę podać ID klienta!");
                return;
            }

            try {
                const response = await fetch(`/clients/average-rental-days/${clientId}`);
                const data = await response.json();

                if (data.error) {
                    document.getElementById("averageRentalDaysResult").textContent = data.error;
                } else {
                    document.getElementById("averageRentalDaysResult").textContent = 
                        `Średnia liczba dni wypożyczenia dla klienta o ID ${clientId}: ${data.srednia_dni}`;
                }
            } catch (error) {
                console.error(error);
                document.getElementById("averageRentalDaysResult").textContent = 
                    "Wystąpił błąd podczas próby pobrania danych.";
            }
        }
    </script>

</body>
</html>
