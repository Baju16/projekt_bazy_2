<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Przychody</title>
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        .container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <h1>Sumy Przychodów</h1>

    <!-- Formularz do podania zakresu dat -->
    <div class="container">
        <h2>Wprowadź zakres dat</h2>
        <form id="revenueForm">
            <label for="start_date">Data początkowa:</label>
            <input type="date" id="start_date" name="start_date" required><br><br>
            <label for="end_date">Data końcowa:</label>
            <input type="date" id="end_date" name="end_date" required><br><br>
            <button type="submit">Pobierz sumę przychodów</button>
        </form>

        <h2>Całkowity przychód</h2>
        <p id="totalRevenue">Ładowanie...</p>
    </div>

    <script>
        // Funkcja do pobierania sumy przychodów z serwera
        async function fetchTotalRevenue(startDate, endDate) {
            try {
                const response = await fetch(`/revenues/total-revenue?start_date=${startDate}&end_date=${endDate}`);
                if (!response.ok) {
                    throw new Error('Błąd sieci');
                }
                const data = await response.json();
                if (data.total_revenue === undefined) {
                    throw new Error('Niepoprawne dane');
                }
                document.getElementById('totalRevenue').textContent = `Suma przychodów: ${parseFloat(data.total_revenue).toFixed(2)} PLN`;
            } catch (error) {
                console.error('Błąd podczas pobierania sumy przychodów:', error);
                document.getElementById('totalRevenue').textContent = 'Błąd ładowania danych';
            }
        }

        // Obsługa formularza
        document.getElementById('revenueForm').addEventListener('submit', function (event) {
            event.preventDefault();
            const startDate = document.getElementById('start_date').value;
            const endDate = document.getElementById('end_date').value;

            if (startDate && endDate) {
                fetchTotalRevenue(startDate, endDate);
            }
        });

        // Inicjalizacja formularza, jeżeli potrzebujemy jakiegoś działania przy załadowaniu strony
    </script>
</body>
</html>
