<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Samochody</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <h1>Lista Samochodów</h1>

    <!-- Komunikat o błędzie -->
    <% if (error) { %>
        <div class="error-message" style="color: red; font-weight: bold; margin-bottom: 20px;">
            <%= error %>
        </div>
    <% } %>

    <!-- Przycisk do powrotu na stronę główną -->
    <button onclick="window.location.href='/home'">Powrót na stronę główną</button>

    <button onclick="window.location.href='/cars/rental-stats'">Zobacz ilość wypoyczeń dla samochodu</button>

    <!-- Formularz dodawania nowego samochodu -->
    <h2>Dodaj nowy samochód</h2>
    <form action="/cars/add" method="POST">
        <label for="marka">Marka:</label>
        <input type="text" id="marka" name="marka" required><br>
        <label for="model">Model:</label>
        <input type="text" id="model" name="model" required><br>
        <label for="rok">Rok:</label>
        <input type="number" id="rok" name="rok" required><br>
        <label for="numer">Numer rejestracyjny:</label>
        <input type="text" id="numer" name="numer" required><br>
        <label for="cena">Cena:</label>
        <input type="number" step="0.01" id="cena" name="cena" required><br>
        <label for="id_ubezpieczenia">ID ubezpieczenia:</label>
        <input type="text" id="id_ubezpieczenia" name="id_ubezpieczenia"><br>
        <label for="czy_wypozyczony">Czy wypożyczony:</label>
        <input type="checkbox" id="czy_wypozyczony" name="czy_wypozyczony"><br>
        <button type="submit">Zapisz</button>
    </form>

    <!-- Sekcja z listą samochodów -->
    <h2>Lista samochodów</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Marka</th>
                <th>Model</th>
                <th>Rok</th>
                <th>Numer rejestracyjny</th>
                <th>Cena</th>
                <th>ID ubezpieczenia</th>
                <th>Czy wypożyczony</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            <% cars.forEach(car => { %>
                <tr>
                    <td><%= car.id %></td>
                    <td><%= car.marka %></td>
                    <td><%= car.model %></td>
                    <td><%= car.rok_produkcji %></td>
                    <td><%= car.numer_rejestracyjny %></td>
                    <td><%= car.cena_za_dzien %></td>
                    <td><%= car.id_ubezpieczenia %></td>
                    <td><%= car.czy_wypozyczony ? 'Tak' : 'Nie' %></td>
                    <td>
                        <!-- Przycisk do edytowania samochodu -->
                        <button onclick="editCar('<%= car.id %>', '<%= car.marka %>', '<%= car.model %>', '<%= car.rok_produkcji %>', '<%= car.numer_rejestracyjny %>', '<%= car.cena_za_dzien %>', '<%= car.id_ubezpieczenia %>', '<%= car.czy_wypozyczony %>')">Edytuj</button>
                        <!-- Link do usuwania samochodu -->
                        <a href="/cars/delete/<%= car.id %>">Usuń</a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
</html>
