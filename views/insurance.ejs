<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ubezpieczenia</title>
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        /* Stylizacja dla podziału na dwie kolumny */
        .container {
            display: flex;
            justify-content: space-between;
        }

        .left-column {
            flex: 1;
            margin-right: 20px;
        }

        .right-column {
            flex: 1;
        }

        /* Dodatkowe stylizacje tabeli */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        table, th, td {
            border: 1px solid black;
        }

        th, td {
            padding: 8px;
            text-align: left;
        }
    </style>
</head>
<body>
    <h1>Lista Ubezpieczeń</h1>

    <!-- Komunikat o błędzie -->
    <% if (error) { %>
        <div class="error-message" style="color: red; font-weight: bold; margin-bottom: 20px;">
            <%= error %>
        </div>
    <% } %>

    <!-- Przycisk do powrotu na stronę główną -->
    <button onclick="window.location.href='/home'">Powrót na stronę główną</button>

    <!-- Kontener dla formularza i listy samochodów -->
    <div class="container">
        <!-- Formularz dodawania ubezpieczenia -->
        <div class="left-column">
            <h2>Dodaj nowe ubezpieczenie</h2>
            <form action="/insurance/add" method="POST">
                <label for="ubezpieczyciel">Ubezpieczyciel:</label>
                <input type="text" id="ubezpieczyciel" name="ubezpieczyciel" required><br>
                <label for="data_poczatku">Data początku:</label>
                <input type="date" id="data_poczatku" name="data_poczatku" required><br>
                <label for="data_konca">Data końca:</label>
                <input type="date" id="data_konca" name="data_konca" required><br>
                <label for="koszt_ubezpieczenia">Koszt ubezpieczenia:</label>
                <input type="number" step="0.01" id="koszt_ubezpieczenia" name="koszt_ubezpieczenia" required><br>
                <button type="submit">Zapisz</button>
            </form>
        </div>

        <!-- Sekcja z samochodami z końcem ubezpieczenia -->
        <div class="right-column">
            <% if (carsEndInsurance && carsEndInsurance.length > 0) { %>
                <h3>Samochody z końcem ubezpieczenia w ciągu 30 dni:</h3>
                <table>
                    <thead>
                        <tr>
                            <th>ID Samochodu</th>
                            <th>Marka</th>
                            <th>Model</th>
                            <th>Numer rejestracyjny</th>
                            <th>Data końca ubezpieczenia</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% carsEndInsurance.forEach(car => { %>
                            <tr>
                                <td><%= car.id_samochodu %></td>
                                <td><%= car.marka %></td>
                                <td><%= car.model %></td>
                                <td><%= car.numer_rejestracyjny %></td>
                                <td><%= car.data_konca %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p>Brak samochodów z końcem ubezpieczenia w ciągu 30 dni.</p>
            <% } %>
        </div>
    </div>

    <!-- Sekcja z listą ubezpieczeń -->
    <h2>Lista ubezpieczeń</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Ubezpieczyciel</th>
                <th>Data początku</th>
                <th>Data końca</th>
                <th>Koszt</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            <% insurance.forEach(item => { %>
                <tr>
                    <td><%= item.id %></td>
                    <td><%= item.ubezpieczyciel %></td>
                    <td><%= item.data_poczatku %></td>
                    <td><%= item.data_konca %></td>
                    <td><%= item.koszt_ubezpieczenia %></td>
                    <td>
                        <!-- Przycisk do edytowania ubezpieczenia -->
                        <button onclick="editInsurance('<%= item.id %>', '<%= item.ubezpieczyciel %>', '<%= item.data_poczatku %>', '<%= item.data_konca %>', '<%= item.koszt_ubezpieczenia %>')">Edytuj</button>
                        <!-- Link do usuwania ubezpieczenia -->
                        <a href="/insurance/delete/<%= item.id %>">Usuń</a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <!-- Formularz edytowania ubezpieczenia -->
    <h2>Edytuj ubezpieczenie</h2>
    <form id="editForm" action="" method="POST" style="display: none;">
        <input type="hidden" id="editId" name="id">
        <label for="editUbezpieczyciel">Ubezpieczyciel:</label>
        <input type="text" id="editUbezpieczyciel" name="ubezpieczyciel" required><br>
        <label for="editData_poczatku">Data początku:</label>
        <input type="date" id="editData_poczatku" name="data_poczatku" required><br>
        <label for="editData_konca">Data końca:</label>
        <input type="date" id="editData_konca" name="data_konca" required><br>
        <label for="editKoszt_ubezpieczenia">Koszt ubezpieczenia:</label>
        <input type="number" step="0.01" id="editKoszt_ubezpieczenia" name="koszt_ubezpieczenia" required><br>
        <button type="submit">Zapisz zmiany</button>
    </form>

    <script>
        // Funkcja do załadowania formularza edytowania
        function editInsurance(id, ubezpieczyciel, data_poczatku, data_konca, koszt_ubezpieczenia) {
            // Pokaż formularz edytowania
            document.getElementById("editForm").style.display = "block";
            
            // Wstaw dane do formularza
            document.getElementById("editId").value = id;
            document.getElementById("editUbezpieczyciel").value = ubezpieczyciel;
            document.getElementById("editData_poczatku").value = data_poczatku;
            document.getElementById("editData_konca").value = data_konca;
            document.getElementById("editKoszt_ubezpieczenia").value = koszt_ubezpieczenia;

            // Zmieniamy akcję formularza na edytowanie konkretnego ubezpieczenia
            document.getElementById("editForm").action = "/insurance/edit/" + id;
        }
    </script>
</body>
</html>
